<Controls:DefaultWindow xmlns="https://spacestation14.io"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:Controls="clr-namespace:Robust.Client.UserInterface.CustomControls;assembly=Robust.Client"
                        xmlns:cc="clr-namespace:Robust.Client.UserInterface.Controls;assembly=Robust.Client"
                        x:Class="Content.Client.DeadSpace.Ninja.UI.NinjaInfoScannerWindow"
                        Title="{Loc 'ninja-info-ui-title'}">
    <BoxContainer Orientation="Vertical">
        <cc:SpriteView Name="TargetView" />
        <Label Name="StatusLabel" />
        <Button Name="ScanButton" Text="{Loc 'ninja-info-ui-scan'}" />
        <Button Name="EjectButton" Text="{Loc 'ninja-info-ui-eject'}" />
        <Button Name="TeleportButton" Text="{Loc 'ninja-info-ui-teleport'}" />
    </BoxContainer>
</Controls:DefaultWindow>